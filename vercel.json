{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/for-her",
            "destination": "/for-her/index.html"
        },
        {
            "source": "/for-her/(.*)",
            "destination": "/for-her/index.html"
        }
    ]
}
